enabled = false

[settings]
# Retention pruning job
prune_enabled = true
prune_interval_seconds = 3600

# Retention windows (days)
# Set to 0 to disable pruning for a table.
retention_matches_days = 30
retention_sessions_days = 30
retention_events_days = 30
retention_admin_actions_days = 90
retention_chat_messages_days = 30

# Dashboard analytics helper defaults
analytics_default_window_days = 7
analytics_default_limit = 90
