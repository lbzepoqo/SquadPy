[rcon]
host = "127.0.0.1"
port = 21114
password = "your_rcon_password"

# [log]
# enabled = true
# mode = "local"                               # "local" or "sftp"
# path = "/path/to/SquadGame/SquadGame.log"    # log file path
# poll_interval = 0.25                         # seconds between checks
#
# # SFTP settings (only used when mode = "sftp")
# host = "192.168.1.10"
# port = 22
# username = "squad"
# password = "your_sftp_password"

# [discord]
# enabled = true
# token = "your_bot_token_here"
# guild_id = 123456789012345678
# command_prefix = "!"

# [api]
# enabled = true
# host = "127.0.0.1"
# port = 8090
# websocket_path = "/ws/control"
# auth_token = "replace_with_long_random_token"
# rbac_enabled = false
# rbac_default_role = "admin"
# rbac_role_permissions = { admin = ["*"], moderator = ["control.health", "control.status", "layers.query"], observer = ["control.health"] }
# webhook_signing_enabled = false
# webhook_signing_secret = "replace_with_webhook_hmac_secret"
# webhook_signature_header = "X-SquadPy-Signature"
# webhook_timestamp_header = "X-SquadPy-Timestamp"
# webhook_max_age_seconds = 300
